{
	"name": "pageflash",
	"version": "1.2.0",
	"description": "Preload pages intelligently to boost site speed and enhance user experience by loading pages before users click, ensuring instant page transitions",
	"author": "theaminul",
	"license": "GPL-3.0-or-later",
	"keywords": [
		"WordPress",
		"pageflash",
		"headless browser"
	],
	"homepage": "https://github.com/theaminuli/pageflash/",
	"repository": "git+https://github.com/theaminuli/pageflash.git",
	"bugs": {
		"url": "https://wordpress.org/support/plugin/pageflash/"
	},
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"dependencies": {
		"react-content-loader": "^7.1.2",
		"react-icons": "^5.5.0",
		"react-router": "^7.9.4",
		"react-toastify": "^11.0.5"
	},
	"devDependencies": {
		"@actions/core": "^1.11.1",
		"@wordpress/icons": "^9.46.0",
		"@wordpress/scripts": "^30.7.0",
		"concurrently": "^9.1.0",
		"grunt": "^1.6.1",
		"grunt-checktextdomain": "^1.0.1",
		"load-grunt-tasks": "^5.1.0",
		"npm-check-updates": "^16.14.20",
		"path": "^0.12.7",
		"simple-git": "^3.27.0",
		"webpack-remove-empty-scripts": "^1.0.4"
	},
	"scripts": {
		"build": "concurrently \"wp-scripts build\" \"grunt\"",
		"start": "wp-scripts start",
		"start:hot": "wp-scripts start --hot",
		"make-pot": "wp i18n make-pot ./languages/pageflash.pot",
		"format": "wp-scripts format --path=src",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:standard": "vendor\\bin\\phpcs --standard=phpcs.xml",
		"lint:wpcs": "vendor\\bin\\phpcs --standard=phpcs.xml",
		"lint:wpcs:fix": "vendor\\bin\\phpcbf --standard=phpcs.xml",
		"lint:fix": "wp-scripts lint-js --fix && wp-scripts lint-style --fix",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"update-version": "node update-version-and-changelog.js",
		"plugin-zip": "wp-scripts plugin-zip",
		"zip": "concurrently \"wp-scripts build\" \"grunt\" && composer archive --file=../dist/pageflash"
	}
}
